{
  "name": "room-booking-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-auth-session": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "android:go": "expo start --go --android",
    "android:dev-build": "expo run:android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.js",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:report": "playwright show-report e2e/.output/report"
  },
  "private": true
}
