# Copy this file to .env.local (gitignored) and set the address of the
# meeting-room-booking API. Leave EXPO_PUBLIC_API_URL unset to use demo data.
# After changing it, reload the app (press r in the Expo terminal).
#
# The right address depends on where the app runs, because "localhost" always
# means the device itself:
#
#   Web in a browser on this PC   http://localhost:5003
#                                 (the API allows CORS from http://localhost:8081
#                                 in its Development environment)
#   iOS Simulator                 http://localhost:5003
#   Android Emulator              http://10.0.2.2:5003
#                                 (10.0.2.2 is the emulator's alias for the host PC)
#   Physical phone (Expo Go)      http://<your PC's LAN IP>:5003
#                                 (API must listen on 0.0.0.0, PC firewall must
#                                 allow port 5003, phone on the same Wi-Fi)
#
# EXPO_PUBLIC_ values are embedded in the app bundle, so never put secrets here.

EXPO_PUBLIC_API_URL=http://localhost:5003

# Microsoft Entra ID login (Android/iOS development build only; see README,
# "Microsoft Entra login"). Leave both unset to run without login. These are
# identifiers of public app registrations, not secrets: the app is a public
# client and never has a client secret. Never put a client secret here.
#
#   EXPO_PUBLIC_ENTRA_CLIENT_ID   Application (client) ID of the mobile app registration
#   EXPO_PUBLIC_ENTRA_API_SCOPE   api://<API client ID>/access_as_user (the API registration's scope)
#   EXPO_PUBLIC_ENTRA_TENANT      organizations (default), or a tenant ID or domain

# EXPO_PUBLIC_ENTRA_CLIENT_ID=
# EXPO_PUBLIC_ENTRA_API_SCOPE=
# EXPO_PUBLIC_ENTRA_TENANT=organizations
